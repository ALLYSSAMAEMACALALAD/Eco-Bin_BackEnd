# Copy to .env (or export these in your shell). Never commit real values.

APP_NAME=Eco-Bin
APP_ENV=development

# Database (MySQL 8 / MariaDB 10.4+)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecobin
DB_CHARSET=utf8mb4
DB_PREFIX=

# API / JWT (generate with: php lava jwt:generate  or  php -r "echo bin2hex(random_bytes(32));")
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=EcoBin

# Continue with Facebook (https://developers.facebook.com/apps)
# Valid OAuth Redirect URI: <backend>/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional overrides; normally derived automatically.
FACEBOOK_REDIRECT_URI=
FACEBOOK_GRAPH_VERSION=v23.0
# Where users return after Facebook login. Empty = first entry in CORS_ORIGIN.
FRONTEND_URL=
# Comma-separated frontend origins, e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173
