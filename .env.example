# Copy to .env (or export these in your shell). Never commit real values.

APP_NAME=Eco-Bin
APP_ENV=development

# Database (MySQL 8 / MariaDB 10.4+)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecobin
DB_CHARSET=utf8mb4
DB_PREFIX=

# API / JWT (generate with: php lava jwt:generate  or  php -r "echo bin2hex(random_bytes(32));")
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=EcoBin
CORS_ORIGIN=http://localhost:5173
